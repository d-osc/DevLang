# Runtime inputs: mode, n, seed, rounds (unsigned decimal numbers on stdin).
extern fn getchar() i32
extern fn malloc(bytes usize) *void
extern fn free(memory *void)

fn read_number() u64 {
    let c = getchar()
    while c >= 0 and c <= 32 { c = getchar() }
    let value u64 = 0
    while c >= 48 and c <= 57 {
        value = value * 10 + (c - 48) as u64
        c = getchar()
    }
    return value
}

fn sum_loop(n u64) u64 {
    let total u64 = 0
    let i u64 = 0
    while i < n {
        total += i & 255
        i += 1
    }
    return total
}

fn xorshift(n u64, seed u64) u64 {
    let state = seed
    let i u64 = 0
    while i < n {
        state ^= state << 13
        state ^= state >> 7
        state ^= state << 17
        i += 1
    }
    return state
}

fn array_update(n usize, seed u64, rounds u64) u64 {
    let memory = malloc(n * 8) as *u64
    if memory == null { return 0 }
    let i usize = 0
    while i < n {
        memory[i] = (seed + i as u64) & 0xffffffff
        i += 1
    }
    let round u64 = 0
    while round < rounds {
        i = 0
        while i < n {
            memory[i] = (memory[i] * 1664525 + 1013904223) & 0xffffffff
            i += 1
        }
        round += 1
    }
    let total u64 = 0
    i = 0
    while i < n {
        total += memory[i]
        i += 1
    }
    free(memory as *void)
    return total
}

fn main() {
    let mode = read_number()
    let n = read_number()
    let seed = read_number()
    let rounds = read_number()
    if mode == 1 {
        print(sum_loop(n))
    } else if mode == 2 {
        print(xorshift(n, seed))
    } else if mode == 3 {
        print(array_update(n as usize, seed, rounds))
    } else {
        return 1
    }
}

main()

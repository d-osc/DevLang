fn main() {
    const values = [1, 2, 3, 4]
    print(values.length)
    print(values.length())
    print(values.toString())
    print(Array.isArray(values))
    print(Array.isArray(42))
    let xs = values.toVec()
    let snapshot = xs.slice(0, 4)
    let removed = xs.splice(1, 2, 9, 8, 7)
    print(removed.toString())
    print(xs.toString())
    print(snapshot.toString())
    let changed = xs.toSpliced(-2, 1, 6)
    print(changed.toString())
    print(xs.toString())
    print(xs.delete(-1))
    xs.copyWithin(1, 0, 3)
    print(xs.toString())
    let nested = Vec<Vec<i64>>(Vec<i64>(1, 2), Vec<i64>(3, 4))
    print(nested.flat().toString())
    print(nested.flat(0).length)
    print([true, false].toString())
    print(["Hello", "Dev"].toString())
    let data = { items: [1, "Dev", true, null], missing: null }
    print(Array.isArray(data.items))
    print(Array.isArray(data))
    print(Array.isArray(data.missing))
}
main()

fn main() {
    const values = [1, 2, 3, 2]
    print(values.at(-1))
    let doubled = values.map(fn(n: i64): i64 { return n * 2 })
    print(doubled.at(0))
    let even = values.filter(fn(n: i64): bool { return n % 2 == 0 })
    print(even.len())
    print(values.reduce(fn(sum: i64, n: i64): i64 { return sum + n }, 0))
    print(values.some(fn(n: i64): bool { return n > 2 }))
    print(values.every(fn(n: i64): bool { return n > 0 }))
    print(values.findIndex(fn(n: i64): bool { return n == 2 }))
    print(values.findLastIndex(fn(n: i64): bool { return n == 2 }))
    values[1..3].forEach(fn(n: i64) { print(n) })
    let combined = values.concat([4, 5])
    print(combined.at(-1))
    let reversed = values.toReversed()
    print(reversed.at(0))
    let queue = values.toVec()
    queue.unshift(0)
    print(queue.shift())
    queue.reverse()
    print(queue.at(0))
    print(values.at(0))
    const words = ["Hello", "Dev"]
    print(words.join(" "))
    print(words[1..2].join("-"))
    let empty = Vec<i64>()
    print(empty.every(fn(n: i64): bool { return n > 0 }))
    print(empty.some(fn(n: i64): bool { return n > 0 }))
    print(empty.findIndex(fn(n: i64): bool { return true }))
    print(empty.reduce(fn(a: i64, b: i64): i64 { return a + b }, 10))
    let multiplier = 3
    print(values.map(fn(n: i64): i64 { return n * multiplier }).at(0))
}
main()

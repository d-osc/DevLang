fn main() {
    const numbers = [10, 20, 30]
    numbers.forEach(fn(value: i64, index: i64) {
        print("${index}: ${value}")
    })
    let mapped = numbers.map(fn(value: i64, index: i64): i64 { return value + index })
    print(mapped.at(2))
    let selected = numbers.filter(fn(value: i64, index: i64): bool { return index % 2 == 0 })
    print(selected.len())
    print(numbers.some(fn(value: i64, index: i64): bool { return index == 1 }))
    print(numbers.every(fn(value: i64, index: i64): bool { return value > index }))
    print(numbers.findIndex(fn(value: i64, index: i64): bool { return index == 1 }))
    print(numbers.findLastIndex(fn(value: i64, index: i64): bool { return index > 0 }))
    print(numbers.reduce(fn(total: i64, value: i64, index: i64): i64 { return total + value + index }, 0))
    numbers[1..3].forEach(fn(value: i64, index: i64) { print("slice ${index}: ${value}") })
    numbers.forEach(fn(value: i64) { print(value) })
}
main()

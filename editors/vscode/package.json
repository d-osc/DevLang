{
  "name": "devlang-language",
  "displayName": "DevLang",
  "description": "DevLang and DON syntax, formatting, file icons, language server and native breakpoint support.",
  "version": "0.2.0",
  "publisher": "n-devs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/d-osc/DevLang.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:devlang",
    "onLanguage:don",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The language server launches the configured DevLang executable."
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check file-icons.js",
    "package": "vsce package",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "devlang",
        "aliases": [
          "DevLang",
          "dev"
        ],
        "extensions": [
          ".dev"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-dev.svg",
          "dark": "./images/file-dev.svg"
        }
      },
      {
        "id": "don",
        "aliases": [
          "Dev Object Notation",
          "DON",
          "don"
        ],
        "extensions": [
          ".don"
        ],
        "configuration": "./don-language-configuration.json",
        "icon": {
          "light": "./images/file-don.svg",
          "dark": "./images/file-don.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "devlang",
        "scopeName": "source.devlang",
        "path": "./syntaxes/devlang.tmLanguage.json"
      },
      {
        "language": "don",
        "scopeName": "source.don",
        "path": "./syntaxes/don.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "devlang"
      }
    ],
    "configuration": {
      "title": "DevLang",
      "properties": {
        "devlang.executablePath": {
          "type": "string",
          "default": "d",
          "scope": "machine-overridable",
          "description": "Path to the latest d executable. Restart the extension host after changing it."
        },
        "devlang.autoFileIcon": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Automatically add .dev and .don file icons to the active Material Icon Theme. Preserves other icons and custom associations."
        }
      }
    },
    "configurationDefaults": {
      "[devlang]": {
        "editor.defaultFormatter": "n-devs.devlang-language",
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.showUnused": true
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.line.devlang",
            "settings": {
              "foreground": "#82958A",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "keyword.control.devlang",
            "settings": {
              "foreground": "#C6AEED"
            }
          },
          {
            "scope": "storage.type.devlang",
            "settings": {
              "foreground": "#C6AEED"
            }
          },
          {
            "scope": "string.quoted.double.devlang",
            "settings": {
              "foreground": "#B5D99A"
            }
          },
          {
            "scope": "constant.character.escape.devlang",
            "settings": {
              "foreground": "#E9CB8B"
            }
          },
          {
            "scope": "constant.numeric.devlang",
            "settings": {
              "foreground": "#ECB78F"
            }
          },
          {
            "scope": "constant.language.devlang",
            "settings": {
              "foreground": "#ECB78F"
            }
          },
          {
            "scope": "entity.name.function.devlang",
            "settings": {
              "foreground": "#E5CE94"
            }
          },
          {
            "scope": "entity.name.type.devlang",
            "settings": {
              "foreground": "#91DCC6"
            }
          },
          {
            "scope": "support.type.devlang",
            "settings": {
              "foreground": "#91DCC6"
            }
          },
          {
            "scope": "keyword.operator.devlang",
            "settings": {
              "foreground": "#9FCBE5"
            }
          },
          {
            "scope": "comment.line.don",
            "settings": {
              "foreground": "#82958A"
            }
          },
          {
            "scope": "comment.block.don",
            "settings": {
              "foreground": "#82958A"
            }
          },
          {
            "scope": "support.type.property-name.don",
            "settings": {
              "foreground": "#91DCC6"
            }
          },
          {
            "scope": [
              "string.quoted.double.don",
              "string.quoted.single.don",
              "string.quoted.triple.don"
            ],
            "settings": {
              "foreground": "#B5D99A"
            }
          },
          {
            "scope": "constant.numeric.don",
            "settings": {
              "foreground": "#ECB78F"
            }
          },
          {
            "scope": "constant.language.don",
            "settings": {
              "foreground": "#C6AEED"
            }
          },
          {
            "scope": "variable.other.reference.don",
            "settings": {
              "foreground": "#E5CE94"
            }
          },
          {
            "scope": "punctuation.separator.key-value.don",
            "settings": {
              "foreground": "#9FCBE5"
            }
          },
          {
            "scope": "constant.character.escape.don",
            "settings": {
              "foreground": "#E9CB8B"
            }
          }
        ]
      },
      "[don]": {
        "editor.defaultFormatter": "n-devs.devlang-language",
        "editor.insertSpaces": true,
        "editor.tabSize": 4
      }
    },
    "commands": [
      {
        "command": "devlang.restartServer",
        "title": "DevLang: Restart Language Server"
      }
    ],
    "iconThemes": [
      {
        "id": "devlang-icons",
        "label": "DevLang File Icons",
        "path": "./devlang-icons.json"
      }
    ]
  },
  "icon": "images/icon.png"
}

{
  "scopeName": "source.devlang",
  "patterns": [
    {
      "name": "comment.block.devlang",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.triple.devlang",
      "begin": "\"\"\"",
      "end": "\"\"\""
    },
    {
      "name": "string.quoted.single.devlang",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.devlang",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "comment.line.devlang",
      "match": "(#|\\/\\/).*$"
    },
    {
      "name": "string.quoted.double.devlang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.devlang",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.devlang",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.devlang"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.devlang"
            }
          },
          "contentName": "source.devlang",
          "patterns": [
            {
              "include": "#interpolation-braces"
            },
            {
              "include": "$self"
            },
            {
              "name": "variable.other.readwrite.devlang",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            }
          ]
        }
      ]
    },
    {
      "name": "keyword.control.devlang",
      "match": "\\b(if|else|switch|case|default|while|for|in|return|break|continue|match|unsafe|use|export|as|await|new)\\b"
    },
    {
      "name": "storage.type.devlang",
      "match": "\\b(fn|async|let|const|this|struct|enum|trait|extern)\\b"
    },
    {
      "name": "constant.language.devlang",
      "match": "\\b(true|false|null)\\b"
    },
    {
      "name": "support.type.devlang",
      "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|isize|usize|f32|f64|bool|str|void|Ref|Vec|Map|Slice|Task)\\b"
    },
    {
      "name": "constant.numeric.devlang",
      "match": "\\b(0[xX][0-9a-fA-F_]+|[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?)\\b"
    },
    {
      "name": "entity.name.function.devlang",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    {
      "name": "entity.name.type.devlang",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    {
      "name": "keyword.operator.devlang",
      "match": "\\?|:|&&|\\|\\||==|!=|<=|>=|[+*\\/%=<>!&|\\-]"
    }
  ],
  "repository": {
    "interpolation-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#interpolation-braces"
        },
        {
          "include": "$self"
        }
      ]
    }
  }
}

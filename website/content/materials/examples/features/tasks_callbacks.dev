async fn answer(n i64) Ref<i64> { return ref(n + 1) }

fn make(offset i64) fn(i64) i64 {
    let retained = ref(offset)
    return fn(value i64) i64 { return deref(retained) + value }
}

fn main() {
    let results = Map<i64, i64>()
    for i in 0..1000 { results.set(i, i * 2) }
    let snapshot = results
    results.remove(21)
    print(snapshot.get(21))

    let task = answer(41)
    // A real event loop can do other work here and poll on its next tick.
    while !ready(task) {}
    print(deref(await(task)))

    unsafe {
        let first = callback(make(19))
        let second = callback(make(23))
        print(first(23))
        print(second(19))
    }
}

main()

use "std/json"
fn main(){
 let xs=new Array("Dev",42,true,null,0.1)
 print(xs.includes(42))
 print(xs.indexOf("Dev"))
 print(xs.lastIndexOf(null))
 print(xs.join("|"))
 print(xs.toString())
 let sorted=new Array(10,2,1).toSorted()
 print(sorted.toString())
 let ns=new Array(10,2,1)
 ns.sort(fn(a:json.Value,b:json.Value):i64{return json.int(a)-json.int(b)})
 print(ns.toString())
 let nested=new Array([1,[2,3]],[],[4])
 print(json.stringify(nested.flat()))
 print(nested.flat().toString())
 print(json.stringify(nested.flat(2)))
 print(nested.flat(2).toString())
 let p=new Object({name:"Dev"})
 let os=new Array(p,p,new Object({name:"Other"}))
 print(os.indexOf(p))
 print(os.lastIndexOf(p))
 print(os.includes(new Object({name:"Dev"})))
 print(os.join(","))
 Object.defineProperty(p,"toString",{value:fn(this:json.Value):str{return this.name},configurable:true})
 print(os.join(","))
 let nestedObjects=new Array([p])
 let flatObjects=nestedObjects.flat()
 print(flatObjects.includes(p))
 print(flatObjects.join(","))
}
main()

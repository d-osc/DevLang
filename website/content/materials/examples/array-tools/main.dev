fn make(): [i64; 3] { return [1, 2, 3] }
fn total(values: [i64; 3]): i64 {
    let result: i64 = 0
    for value in values { result += value }
    return result
}
fn main() {
    let values = make()
    print(total(values))
    let [first, second, ...rest] = values
    print(first)
    print(second)
    print(rest[0])
    let combined = [0, ...values, ...rest, 4]
    for item in combined { print(item) }
    let middle = values[1..3]
    print(middle[0])
    print(middle.len())
    let zeros: [i32; 4] = [0; 4]
    print(zeros.len())
    let copy = values
    copy[0] = 99
    print(values[0])
    let object = { items: [5, 6], first: fn(): i64 { return this.items[0] } }
    print(object.first())
}
main()

fn main() {
    let age = 18
    const label = age >= 18 ? "adult" : "child"
    print(label)

    let score = 85
    let grade = score >= 90 ? "A" : score >= 80 ? "B" : "C"
    print(grade)

    // Only the selected branch is evaluated.
    print(true ? 42 : 1 / 0)
    let count: i32 = false ? 1 : 2
    print(count)
}
main()
